# =============================================
# DevSecOps Platform - Environment Variables
# Copy this file to .env and fill in values
# =============================================

# --- Database ---
POSTGRES_USER=devsecops
POSTGRES_PASSWORD=devsecops
POSTGRES_DB=devsecops
DATABASE_URL=postgres://devsecops:devsecops@postgres:5432/devsecops?sslmode=disable
# Optional: host-side DB URL used by integration tests (`go test -tags integration`).
# If your DB runs via docker-compose with published port 5432, prefer localhost.
TEST_DATABASE_URL=postgres://devsecops:devsecops@localhost:5432/devsecops?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Worker ---
# Quantos repos o worker escaneia em paralelo (clones simultaneos em /tmp).
WORKER_CONCURRENCY=3
MALICIOUS_DATASET_ENABLED=true
MALICIOUS_DATASET_URL=https://codeload.github.com/ossf/malicious-packages/zip/refs/heads/main
MALICIOUS_DATASET_TIMEOUT_SECONDS=120
GUARDDOG_ENABLED=false
GUARDDOG_BINARY=guarddog
GUARDDOG_TIMEOUT_SECONDS=120

# --- OpenSSF Package Dynamic Analysis (Fase base) ---
# Quando true, findings high/critical enfileiram analise dinamica assincrona.
PACKAGE_DYNAMIC_ANALYSIS_ENABLED=false
# Endpoint HTTP (proxy/mock) que executa a analise dinamica.
PACKAGE_DYNAMIC_ANALYSIS_ENDPOINT_URL=
# Timeout da chamada HTTP da analise dinamica.
PACKAGE_DYNAMIC_ANALYSIS_TIMEOUT_SECONDS=20

# --- LiteLLM (validacao IA de findings) ---
# Proxy OpenAI-compatible. O backend chama POST {LITELLM_BASE_URL}/v1/chat/completions
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini
# Optional per-purpose overrides (fallback to LITELLM_MODEL when empty)
LITELLM_AGENTIC_MODEL=
LITELLM_TRANSLATION_MODEL=
# Enable batch API for scan-triggered translation (agentic analysis stays realtime)
LITELLM_BATCH_ENABLED=false
LITELLM_TIMEOUT_SECONDS=60
LITELLM_MASTER_KEY=sk-admin
# When true, LiteLLM stores models in its DB; model_list in litellm_config.yaml is still the repo source-of-truth for aliases.
STORE_MODEL_IN_DB=True

# --- API Server ---
API_PORT=8080
API_BASE_URL=http://localhost:8080
# URL pública do frontend (redirect pós-login OAuth)
FRONTEND_BASE_URL=http://localhost:3000

# --- JWT ---
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# --- Dev Auth (local login sem SSO — NUNCA usar em produção) ---
DEV_AUTH_ENABLED=true   
VITE_DEV_AUTH_ENABLED=true

# --- SSO feature flags (rollout / rollback) ---
GITHUB_SSO_ENABLED=true
GOOGLE_SSO_ENABLED=true
GITHUB_MEMBERSHIP_SYNC_ENABLED=true
VITE_GITHUB_SSO_ENABLED=true
VITE_GOOGLE_SSO_ENABLED=true

# --- Google OAuth 2.0 (opcional durante transição) ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# --- GitHub OAuth (login principal) ---
# Create OAuth App at: https://github.com/settings/developers
# Callback via Vite proxy em dev (cookie JWT fica no :3000)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# --- GitHub App ---
# App ID and PEM are now stored per-tenant in the database.
# Upload them via the Settings UI after logging in.
# Webhook secret stays here (one shared HMAC for all webhooks).
GITHUB_WEBHOOK_SECRET=

# --- PEM encryption (AES-256-GCM) ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Rotating this key invalidates all stored PEMs - re-upload required.
PEM_ENCRYPTION_KEY=

# --- Frontend ---
# Deixe vazio em dev Docker — axios usa URLs relativas via proxy Vite (:3000)
VITE_API_BASE_URL=
